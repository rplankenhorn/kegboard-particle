/**
 * Kegboard configuration — copy this file to kegboard_config.h and fill in your values.
 * kegboard_config.h is gitignored so your credentials are never committed.
 */

#ifndef KEGBOARD_CONFIG_H
#define KEGBOARD_CONFIG_H

// MQTT broker IP address (as 4 octets)
#define MQTT_SERVER_IP { 192, 168, 1, 1 }

// MQTT broker port
#define MQTT_SERVER_PORT 1883

// MQTT credentials
#define MQTT_USERNAME "your_username"
#define MQTT_PASSWORD "your_password"

#endif // KEGBOARD_CONFIG_H
